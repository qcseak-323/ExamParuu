# ExamParuu — environment template.
#
# Keys only. Never commit a value into this file: it is the one exception to
# the `.env*` rule in .gitignore, so anything written here IS published.
# Copy to .env.local and fill in from the Vercel project (prolymax/examparuu)
# or `vercel env pull`.

# --- Database ---------------------------------------------------------------
# Supabase Postgres, reached through the Prisma 7 driver adapter. DATABASE_URL
# is the pooled connection the app uses; DIRECT_URL is the unpooled one
# migrations need.
#
# WARNING: this is ONE database, shared by development and production. A
# `prisma migrate deploy` from any environment touches live user data, which
# is why every schema change so far has been additive.
DATABASE_URL=
DIRECT_URL=

# --- Auth (Auth.js v5) ------------------------------------------------------
# AUTH_SECRET signs the session cookie; rotating it logs everyone out.
# Sessions are `strategy: "database"`, so the OAuth providers below are
# optional — magic link via Resend is the live sign-in path.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# --- Email ------------------------------------------------------------------
# Resend sends the magic link. Mail from sign-in@mail.examparuu.com lands in
# Junk for at least one tested provider.
RESEND_API_KEY=

# --- Blob storage -----------------------------------------------------------
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# --- Art pipeline (optional) ------------------------------------------------
# Only needed to run art/gen/*.mjs against the PixelLab API. Generation has
# moved to the PixelLab web app, so a normal checkout does not need this.
PIXELLAB_API_KEY=

# --- Injected, do not set by hand -------------------------------------------
# VERCEL_OIDC_TOKEN is written by `vercel env pull` / `vercel dev` and expires.
# Nothing in this app reads it; the code touches only DATABASE_URL, NODE_ENV
# and RESEND_API_KEY.
