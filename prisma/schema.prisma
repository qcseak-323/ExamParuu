// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models (standard Prisma adapter schema) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // The starter chosen on first sign-in: "fire" | "water" | "wood".
  // Null means the trainer hasn't picked yet, which is what routes them to
  // the starter-select screen. Deliberately not an enum: adding a fourth
  // element later shouldn't need a migration on a shared production database.
  examPal       String?
  // Optional trainer nickname for the pal, shown in battle dialogue.
  examPalName   String?
  // Trainer sprite chosen during setup: "boy" | "girl". Same nullable-string
  // convention as examPal — additive, and NULL just means "not chosen yet".
  trainerAvatar String?
  // Self-reported experience with Microsoft certification exams:
  // "new" | "some" | "certified". Used to pitch guidance, not to gate content.
  expertise     String?
  // Exam code the trainer wants to focus on first, e.g. "dp-600". Not a
  // relation: exams live in content files, not the database.
  priorityExam  String?

  accounts           Account[]
  sessions           Session[]
  quizAttempts       QuizAttempt[]
  flashcardProgress  FlashcardProgress[]
  learningEvents     LearningEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  // Id generated on the client when the attempt was taken. Lets the same
  // attempt be reconciled between localStorage and the database without
  // creating duplicates when a device syncs more than once.
  clientId     String
  examCode     String
  domainFilter String
  numQuestions Int
  correctCount Int
  results      Json
  takenAt      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, examCode])
}

/// Append-only log of learning actions (lessons read, cards reviewed).
/// Mirrors QuizAttempt's shape deliberately: a client-generated id plus a
/// per-user uniqueness constraint, so repeat syncs collapse instead of
/// duplicating. A new table rather than new columns keeps this migration
/// additive against the shared production database.
model LearningEvent {
  id       String   @id @default(cuid())
  userId   String
  /// Deterministic id from the client: "kind:examCode:refId:day".
  clientId String
  examCode String
  kind     String
  /// Section id for a lesson, card id for a review.
  refId    String
  at       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, examCode])
}

model FlashcardProgress {
  id        String   @id @default(cuid())
  userId    String
  examCode  String
  cardId    String
  status    String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
}
