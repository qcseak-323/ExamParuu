{
  "name": "examparuu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "prisma migrate deploy && next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/verify-assets.mjs",
    "art:tiers": "node scripts/build-tiers.mjs",
    "art:verify": "node scripts/verify-assets.mjs",
    "postinstall": "prisma generate",
    "shots": "node scripts/shots.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "storybook": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "vite": "latest",
    "eslint-plugin-storybook": "^10.5.7",
    "vitest": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
